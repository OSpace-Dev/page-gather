# 复制为部署目录 .env 后按环境填写；不要添加账号、密码、Cookie或Token。
# Chrome完整版本应从官方仓库确认；不能假定历史版本一直可下载。
CHROME_VERSION=<完整Chrome-deb版本>

# P2可信本机开发预览；实际服务器以后复用现有域名/NGINX/HTTPS。
PAGE_GATHER_NODE_ENV=development
PAGE_GATHER_PUBLIC_ORIGIN=http://127.0.0.1:18080
PAGE_GATHER_COOKIE_SECURE=false
PAGE_GATHER_WEB_PORT=18080
PAGE_GATHER_P2_BROWSER_PORT=16080
PAGE_GATHER_NOVNC_ORIGINS=http://127.0.0.1:16080
VITE_BROWSER_PREVIEW_URL=http://127.0.0.1:16080/vnc.html

# 默认不开启网络兼容开关，不作为防检测或防封禁措施。
CHROME_DISABLE_HTTP2=0
CHROME_DISABLE_QUIC=0
