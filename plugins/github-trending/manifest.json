{
  "id": "github-trending",
  "version": "0.1.0",
  "engineApiVersion": "1",
  "name": "GitHub 每日 Trending README",
  "allowedDomains": ["github.com"],
  "loginRequired": false,
  "capabilities": ["collect"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "since": { "const": "daily", "default": "daily" },
      "language": { "type": "string", "pattern": "^[a-z0-9][a-z0-9+#.-]{0,49}$" },
      "spokenLanguage": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
      "maxRepos": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 },
      "itemDelayMs": { "type": "integer", "minimum": 3000, "maximum": 3600000, "default": 5000 }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": ["collectionId", "collectionSeq", "taskSnapshotRef", "scopeKey", "completeness", "observedAt", "capturedDate", "snapshot", "terminalItemFailures", "blockedBatch", "items", "errors"],
    "properties": {
      "taskSnapshotRef": { "type": ["string", "null"] },
      "checkpoint": {
        "type": "object",
        "required": ["phase", "stateHash"],
        "properties": { "phase": { "const": "OPEN" }, "stateHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
      },
      "collectionId": { "type": "string" },
      "collectionSeq": { "type": "integer", "minimum": 1 },
      "scopeKey": { "type": "string" },
      "completeness": { "enum": ["complete", "partial"] },
      "observedAt": { "type": "string", "format": "date-time" },
      "capturedDate": { "type": "string", "format": "date" },
      "terminalItemFailures": { "type": "array", "items": { "type": "string" } },
      "blockedBatch": { "type": ["string", "null"] },
      "snapshot": {
        "type": "object",
        "required": ["observedAt", "capturedDate", "entries"],
        "properties": {
          "observedAt": { "type": "string", "format": "date-time" },
          "capturedDate": { "type": "string", "format": "date" },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "url", "rank", "description", "language", "stars", "dailyChange", "status", "error"],
              "properties": {
                "key": { "type": "string" },
                "url": { "type": "string", "format": "uri" },
                "rank": { "type": "integer", "minimum": 1 },
                "description": { "type": ["string", "null"] },
                "language": { "type": ["string", "null"] },
                "stars": { "type": ["string", "null"] },
                "dailyChange": { "type": ["string", "null"] },
                "status": { "enum": ["pending", "completed", "failed"] },
                "error": { "type": ["string", "null"] }
              }
            }
          }
        }
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["queueKey", "sourceKey", "sourceUrl", "rank", "observedAt", "readme", "contentHash"],
          "properties": {
            "queueKey": { "type": "string" },
            "sourceKey": { "type": "string" },
            "sourceUrl": { "type": "string", "format": "uri" },
            "rank": { "type": "integer", "minimum": 1 },
            "observedAt": { "type": "string", "format": "date-time" },
            "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "readme": {
              "type": "object",
              "required": ["status", "format", "text", "sourceUrl", "sourceKind", "fileSourceUrl", "truncated"],
              "properties": {
                "status": { "enum": ["found", "not_found"] },
                "format": { "const": "rendered_text" },
                "truncated": { "type": ["boolean", "null"], "description": "null 表示无法确认 GitHub 页面是否已截断；仅采页面正文，不承诺原文件完整" },
                "text": { "type": ["string", "null"] },
                "sourceUrl": { "type": ["string", "null"] },
                "sourceKind": { "enum": ["file", "rendered_page", null], "description": "file 表示明确 README header 文件来源；rendered_page 表示实际仓库页 README 区域，无法确认原文件；not_found 时为 null" },
                "fileSourceUrl": { "type": ["string", "null"], "description": "仅由 README header 明确提供的文件链接；未知或 not_found 时为 null" }
              }
            }
          }
        }
      },
      "errors": { "type": "array", "items": { "type": "object", "required": ["itemKey", "code"], "properties": { "itemKey": { "type": "string" }, "code": { "type": "string" } } } }
    }
  }
}
