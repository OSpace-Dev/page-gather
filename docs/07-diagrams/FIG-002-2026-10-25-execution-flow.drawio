        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#666666;" edge="1" parent="1" source="claim" target="session">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="失效 / 验证码" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#666666;" edge="1" parent="1" source="session" target="login">
          <mxGeometry relative="1" as="geometry" />
