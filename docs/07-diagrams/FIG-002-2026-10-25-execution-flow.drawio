        <mxCell id="e4" value="检查通过后恢复" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="login" target="claim">
          <mxGeometry relative="1" as="geometry">
